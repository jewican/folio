# Copy to backend/.env. Paths below are relative to backend/.
FOLIO_DATA_DIR=./data
FOLIO_DATABASE_PATH=./data/folio.sqlite3
FOLIO_CORS_ORIGINS=http://localhost:3000
# Contract maximum: 10 MiB. Enforcement belongs to W1/W2 during upload implementation.
FOLIO_MAX_UPLOAD_BYTES=10485760

# Backend only. GOOGLE_API_KEY is also accepted; GEMINI_API_KEY takes precedence.
# Never copy either key to web/ or prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Candidate default, NOT confirmed until the live smoke command succeeds.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=1024

# Copy only this public setting to web/.env.local (not the backend secrets above).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
